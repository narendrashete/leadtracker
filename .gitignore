# Recordings parked until they are numbered and matched to an aarti. Local only:
# nothing here is committed, pulled or deployed, and the app cannot see it either
# (the audio manifest only picks up .mp3 files whose name starts with a number).
aartisangrah/audio/archived/

# User-submitted gallery photos, referenced only by shete_gallery rows in
# leads.db (also git-ignored). Content, not code — never committed, persists
# across deploys because git pull never touches untracked files.
shetenavratri/uploads/

# Rishta Album profile photos/page images, referenced by rishta_profiles rows in
# leads.db (also git-ignored). Private content — never committed, survives
# deploys because git pull never touches untracked files.
rishta-data/

# Thigdam album photos (original uploads + collage previews), referenced by
# thigdam_photos rows in leads.db. Friends' personal photos — never committed
# (this repo is public); survive deploys because git pull never touches them.
thigdam-data/
